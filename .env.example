# ==============================================================================
# BINANCE SMC AI AUTO-TRADING ENGINE - ENVIRONMENT VARIABLES
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Required for Deep SMC validation (>80% confidence scoring)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. Supabase Database Configuration
# Used for real-time trade persistence, position tracking, and signal logs
# Get your keys from: Supabase Dashboard > Settings > API
# Project URL: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# ------------------------------------------------------------------------------
# 3. Binance Futures USD-M API Credentials
# Used by CCXT for live market scanning and authenticated order execution
# Create from Binance: Profile > API Management > Create API Key
# IMPORTANT: Check "Enable Futures" permission on your API key
# ------------------------------------------------------------------------------
BINANCE_API_KEY="your_binance_api_key_here"
BINANCE_SECRET_KEY="your_binance_api_secret_key_here"

# Set to "false" for Live Production Trading, or "true" for Binance Futures Testnet
BINANCE_TESTNET="false"

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Risk & Margin Management Rules
# ------------------------------------------------------------------------------
# Maximum percentage of total account USDT balance that can be allocated across all active margins (Default: 10)
MAX_TOTAL_MARGIN_PCT=10
# Strict Isolated Margin Mode ("ISOLATED" only, Cross margin explicitly rejected)
MARGIN_MODE="ISOLATED"
